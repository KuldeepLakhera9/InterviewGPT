datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  MEMBER
  VIEWER
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  planTier  PlanTier @default(FREE) @map("plan_tier")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]
  resumes Resume[]

  @@map("workspaces")
}

model User {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  role          UserRole  @default(MEMBER)
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile?
  candidateProfile CandidateProfile?
  sessions  Session[]
  resumes   Resume[]

  @@index([workspaceId, email])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  fullName  String   @map("full_name")
  avatarUrl String?  @map("avatar_url")
  headline  String?
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model CandidateProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  currentStep      Int      @default(1) @map("current_step")
  completionStatus Int      @default(0) @map("completion_status")
  isSubmitted      Boolean  @default(false) @map("is_submitted")
  draftData        Json     @default("{}") @map("draft_data")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  sessionToken String   @unique @map("session_token")
  expiresAt    DateTime @map("expires_at")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

model Resume {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  fileKey     String   @map("file_key")
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type")
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parsedResume ParsedResume?
  atsAnalysis AtsAnalysis?

  @@index([userId, isActive])
  @@index([workspaceId])
  @@map("resumes")
}

model ParsedResume {
  id                String   @id @default(uuid())
  resumeId          String   @unique @map("resume_id")
  rawText           String   @map("raw_text")
  cleanedText       String   @map("cleaned_text")
  structuredData    Json     @map("structured_data")
  confidenceScores  Json     @map("confidence_scores")
  overallConfidence Float    @map("overall_confidence")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("parsed_resumes")
}

model AtsAnalysis {
  id                 String   @id @default(uuid())
  resumeId           String   @unique @map("resume_id")
  atsScore           Int      @map("ats_score")
  recruiterScore     Int      @map("recruiter_score")
  missingKeywords    Json     @map("missing_keywords")
  weakSections       Json     @map("weak_sections")
  strengths          Json     @map("strengths")
  suggestions        Json     @map("suggestions")
  formattingFeedback Json     @map("formatting_feedback")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("ats_analyses")
}
