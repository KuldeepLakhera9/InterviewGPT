datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  MEMBER
  VIEWER
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  planTier  PlanTier @default(FREE) @map("plan_tier")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]
  resumes Resume[]
  interviewSessions InterviewSession[]
  evaluationReports EvaluationReport[]

  @@map("workspaces")
}

model User {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  role          UserRole  @default(MEMBER)
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile?
  candidateProfile CandidateProfile?
  sessions  Session[]
  resumes   Resume[]
  interviewSessions InterviewSession[]
  interviewDraft InterviewWizardDraft?
  interviewPresets InterviewPreset[]
  questionBankItems QuestionBankItem[]
  evaluationReports EvaluationReport[]
  careerGoals CareerGoal[]
  skillGraph CandidateSkillGraph?
  roadmaps PersonalizedRoadmap[]
  learningItems LearningHubItem[]
  dailyStreak DailyCoachStreak?
  gamification GamificationProfile?
  notifications AppNotification[]

  @@index([workspaceId, email])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  fullName  String   @map("full_name")
  avatarUrl String?  @map("avatar_url")
  headline  String?
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model CandidateProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  currentStep      Int      @default(1) @map("current_step")
  completionStatus Int      @default(0) @map("completion_status")
  isSubmitted      Boolean  @default(false) @map("is_submitted")
  draftData        Json     @default("{}") @map("draft_data")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  sessionToken String   @unique @map("session_token")
  expiresAt    DateTime @map("expires_at")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

model Resume {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  fileKey     String   @map("file_key")
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type")
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parsedResume ParsedResume?
  atsAnalysis AtsAnalysis?
  optimisations ResumeOptimisation[]
  jobMatches JobMatchComparison[]
  assistantSessions ResumeAssistantSession[]
  interviewSessions InterviewSession[]

  @@index([userId, isActive])
  @@index([workspaceId])
  @@map("resumes")
}

model ParsedResume {
  id                String   @id @default(uuid())
  resumeId          String   @unique @map("resume_id")
  rawText           String   @map("raw_text")
  cleanedText       String   @map("cleaned_text")
  structuredData    Json     @map("structured_data")
  confidenceScores  Json     @map("confidence_scores")
  overallConfidence Float    @map("overall_confidence")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("parsed_resumes")
}

model AtsAnalysis {
  id                 String   @id @default(uuid())
  resumeId           String   @unique @map("resume_id")
  atsScore           Int      @map("ats_score")
  recruiterScore     Int      @map("recruiter_score")
  missingKeywords    Json     @map("missing_keywords")
  weakSections       Json     @map("weak_sections")
  strengths          Json     @map("strengths")
  suggestions        Json     @map("suggestions")
  formattingFeedback Json     @map("formatting_feedback")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("ats_analyses")
}

model ResumeOptimisation {
  id                    String   @id @default(uuid())
  resumeId              String   @map("resume_id")
  originalSummary       String   @map("original_summary")
  optimisedSummary      String   @map("optimised_summary")
  originalBullets       Json     @map("original_bullets")
  optimisedBullets      Json     @map("optimised_bullets")
  strongerActionVerbs   Json     @map("stronger_action_verbs")
  measurableImpactItems Json     @map("measurable_impact_items")
  optimisedTextContent  String   @map("optimised_text_content")
  createdAt             DateTime @default(now()) @map("created_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("resume_optimisations")
}

model JobMatchComparison {
  id                          String   @id @default(uuid())
  resumeId                    String   @map("resume_id")
  jobTitle                    String?  @map("job_title")
  companyName                 String?  @map("company_name")
  jobDescriptionText          String   @map("job_description_text")
  overallMatchPercentage      Int      @map("overall_match_percentage")
  missingSkills               Json     @map("missing_skills")
  keywordGaps                 Json     @map("keyword_gaps")
  recommendedImprovements     Json     @map("recommended_improvements")
  recommendedLearningResources Json  @map("recommended_learning_resources")
  createdAt                   DateTime @default(now()) @map("created_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("job_match_comparisons")
}

model ResumeAssistantSession {
  id        String                   @id @default(uuid())
  resumeId  String                   @map("resume_id")
  title     String?                  @map("title")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  resume   Resume                   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  messages ResumeAssistantMessage[]

  @@index([resumeId])
  @@map("resume_assistant_sessions")
}

model ResumeAssistantMessage {
  id        String                 @id @default(uuid())
  sessionId String                 @map("session_id")
  role      String                 @map("role")
  content   String                 @map("content")
  metadata  Json?                  @map("metadata")
  createdAt DateTime               @default(now()) @map("created_at")

  session ResumeAssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("resume_assistant_messages")
}

model InterviewSession {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  userId          String   @map("user_id")
  resumeId        String?  @map("resume_id")
  roleTitle       String   @map("role_title")
  seniorityLevel  String   @map("seniority_level")
  companyName     String?  @map("company_name")
  companyTier     String   @map("company_tier")
  track           String   @map("track")
  difficulty      String   @map("difficulty")
  durationMinutes Int      @map("duration_minutes")
  focusAreas      Json     @default("[]") @map("focus_areas")
  adaptiveMode    Boolean  @default(true) @map("adaptive_mode")
  status          String   @default("created")
  isArchived      Boolean  @default(false) @map("is_archived")
  startedAt       DateTime? @map("started_at")
  pausedAt        DateTime? @map("paused_at")
  endedAt         DateTime? @map("ended_at")
  elapsedSeconds  Int      @default(0) @map("elapsed_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  turns InterviewTurn[]
  evaluation EvaluationReport?
  multimodalData MultimodalSessionData?

  @@index([userId, status])
  @@index([workspaceId])
  @@map("interview_sessions")
}

model InterviewTurn {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  turnIndex   Int      @map("turn_index")
  speaker     String   // interviewer | candidate | system
  messageText String   @map("message_text") @db.Text
  questionId  String?  @map("question_id")
  phase       String   // introduction | primary_question | followup_probe | topic_transition | wrap_up
  topic       String?
  difficulty  String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, turnIndex])
  @@map("interview_turns")
}

model InterviewWizardDraft {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  currentStep Int      @default(1) @map("current_step")
  draftData   Json     @default("{}") @map("draft_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interview_wizard_drafts")
}

model InterviewPreset {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  description     String?
  roleTitle       String   @map("role_title")
  seniorityLevel  String   @map("seniority_level")
  companyName     String?  @map("company_name")
  companyTier     String   @map("company_tier")
  track           String   @map("track")
  difficulty      String   @map("difficulty")
  durationMinutes Int      @map("duration_minutes")
  focusAreas      Json     @default("[]") @map("focus_areas")
  adaptiveMode    Boolean  @default(true) @map("adaptive_mode")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("interview_presets")
}

model QuestionBankItem {
  id                      String   @id @default(uuid())
  title                   String
  questionText            String   @map("question_text")
  category                String   @map("category")
  topic                   String   @map("topic")
  difficulty              String   @map("difficulty")
  companyTags             Json     @default("[]") @map("company_tags")
  roleTags                Json     @default("[]") @map("role_tags")
  expectedDurationSeconds Int      @default(300) @map("expected_duration_seconds")
  followUpReferences      Json     @default("[]") @map("follow_up_references")
  evaluationMetadata      Json     @default("{}") @map("evaluation_metadata")
  isAiGenerated           Boolean  @default(false) @map("is_ai_generated")
  source                  String   @default("system") @map("source")
  createdById             String?  @map("created_by_id")
  workspaceId             String?  @map("workspace_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category, difficulty])
  @@index([topic])
  @@index([workspaceId])
  @@map("question_bank_items")
}

model EvaluationReport {
  id                   String   @id @default(uuid())
  sessionId            String   @unique @map("session_id")
  workspaceId          String   @map("workspace_id")
  userId               String   @map("user_id")
  overallScore         Int      @map("overall_score")
  technicalScore       Int      @map("technical_score")
  communicationScore   Int      @map("communication_score")
  behaviouralScore     Int      @map("behavioural_score")
  hiringRecommendation String   @map("hiring_recommendation")
  hiringJustification  String   @map("hiring_justification") @db.Text
  executiveSummary     String   @map("executive_summary") @db.Text
  strengths            Json     @default("[]")
  weaknesses           Json     @default("[]")
  answerEvaluations    Json     @default("[]") @map("answer_evaluations")
  communicationMetrics Json     @default("{}") @map("communication_metrics")
  starFramework        Json     @default("{}") @map("star_framework")
  skillGraph           Json     @default("{}") @map("skill_graph")
  knowledgeGaps        Json     @default("[]") @map("knowledge_gaps")
  confidenceAnalysis   Json     @default("{}") @map("confidence_analysis")
  learningRoadmap      Json     @default("{}") @map("learning_roadmap")
  recommendedNextSession Json   @default("{}") @map("recommended_next_session")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("evaluation_reports")
}

model MultimodalSessionData {
  id                String   @id @default(uuid())
  sessionId         String   @unique @map("session_id")
  interviewMode     String   @default("practice") @map("interview_mode")
  speechAnalytics   Json     @default("{}") @map("speech_analytics")
  presenceMetrics   Json     @default("{}") @map("presence_metrics")
  codingWorkspace   Json     @default("{}") @map("coding_workspace")
  whiteboardData    Json     @default("{}") @map("whiteboard_data")
  recordingMetadata Json     @default("{}") @map("recording_metadata")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("multimodal_session_data")
}

model CareerGoal {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  dreamCompany      String   @map("dream_company")
  targetRole        String   @map("target_role")
  experienceLevel   String   @map("experience_level")
  salaryGoal        String?  @map("salary_goal")
  preferredIndustry String?  @map("preferred_industry")
  preferredLocation String?  @map("preferred_location")
  targetTimeline    String   @map("target_timeline")
  isPrimary         Boolean  @default(true) @map("is_primary")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
  @@map("career_goals")
}

model CandidateSkillGraph {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  skillsData   Json     @default("[]") @map("skills_data")
  overallScore Int      @default(70) @map("overall_score")
  lastUpdated  DateTime @default(now()) @map("last_updated")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_skill_graphs")
}

model PersonalizedRoadmap {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  title            String
  targetRole       String   @map("target_role")
  dailyPlan        Json     @default("[]") @map("daily_plan")
  weeklyPlan       Json     @default("[]") @map("weekly_plan")
  monthlyPlan      Json     @default("[]") @map("monthly_plan")
  quarterlyPlan    Json     @default("[]") @map("quarterly_plan")
  completionStatus Int      @default(0) @map("completion_status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personalized_roadmaps")
}

model LearningHubItem {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  type       String   // note | resource | flashcard | quiz | practice_set
  title      String
  category   String
  content    Json
  isBookmarked Boolean @default(false) @map("is_bookmarked")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("learning_hub_items")
}

model DailyCoachStreak {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  currentStreak   Int       @default(1) @map("current_streak")
  longestStreak   Int       @default(1) @map("longest_streak")
  lastActiveDate  String    @map("last_active_date")
  dailyTasks      Json      @default("[]") @map("daily_tasks")
  completedTasks  Json      @default("[]") @map("completed_tasks")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_coach_streaks")
}

model GamificationProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  currentXp     Int      @default(250) @map("current_xp")
  currentLevel  Int      @default(2) @map("current_level")
  unlockedBadges Json    @default("[]") @map("unlocked_badges")
  milestones    Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gamification_profiles")
}

model AppNotification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // daily_learning | practice | resume | interview | goal
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  actionUrl String?  @map("action_url")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("app_notifications")
}
